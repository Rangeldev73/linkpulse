# --- INFRASTRUCTURE (Docker Compose) ---
POSTGRES_DB=YOUR_DB_NAME
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_PORT=5432

REDIS_PORT=6379
KAFKA_PORT=9092

# --- LINK SERVICE ---
LINK_SERVICE_PORT=8081
LINK_SERVICE_BASE_URL=http://localhost:8080
LINK_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/YOUR_DB_NAME

# --- REDIRECT SERVICE ---
REDIRECT_SERVICE_PORT=8080

# --- ANALYTICS SERVICE ---
ANALYTICS_SERVICE_PORT=8082

# 32-byte Base64 encoded secret key for HS256 signature validation
LINK_SERVICE_JWT_SECRET_BASE64=YOUR_BASE64_SECRET_KEY_HERE